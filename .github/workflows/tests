name: Shared Test Suite

on:
  workflow_call: # <-- This magic line makes the workflow reusable

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 'lts/*'
          cache: 'npm'

      - name: Install packages
        run: npm ci

      - name: Run tests
        run: npm run test:ci
